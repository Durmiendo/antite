{
  "manifest_version": 2,
  "name": "Antite icons",
  "version": "1.0",
  "browser_specific_settings": {"gecko": {"id": "icons@antite.dev"}},
  "permissions": ["nativeMessaging", "nativeMessagingFromContent", "geckoViewAddons"],
  "content_scripts": [{
    "matches": ["http://*/*", "https://*/*"],
    "js": ["icons.js"],
    "run_at": "document_idle",
    "all_frames": false
  }]
}
