<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Plain http is allowed for every host: debug installs come from a computer in the local network by its IP.
         Pages do not go through this (Gecko has its own network stack); the engine index is checked by its signature
         and every downloaded file by sha256, not by the transport. -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
